% Hyperref settings for clickable links
\usepackage{hyperref}
\hypersetup{
  colorlinks   = true,
  citecolor    = [rgb]{0.0, 0.0, 0.5}, % Darker blue
  linkcolor    = [rgb]{0.5, 0.0, 0.0}, % Darker red
  urlcolor     = gray
  ,breaklinks
}

% Fancyhdr settings for custom headers
\pagestyle{fancy}
\fancyhf{} % Clear default header and footer
\renewcommand{\headrulewidth}{0pt} % Remove header line

% Header configuration
\fancyhead[LE]{\thepage\, / \textit{Supplementary Materials}} % Even pages header
\fancyhead[RO]{} % Odd pages header

% Page numbering settings
\pagenumbering{arabic} % Arabic page numbers
\setcounter{page}{1} % Start page numbering at 1

% Keywords command
\providecommand{\keywords}[1]
{
  \small	
  \textbf{{Keywords:}} #1
}

