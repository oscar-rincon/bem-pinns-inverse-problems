\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Problem setting. Top left: an irregularity $\Omega _1$ with properties $(\mu _1,\rho _1)$, bounded by the free surface $\Gamma _s$ and the interface $\Gamma _I$, embedded in a half-space $\Omega _2$ with properties $(\mu _2,\rho _2)$ and flat free surface $\Gamma _0$, excited by a plane SH wave with frequency $\eta $ and incidence angle $\alpha $; receivers $\mathbf  {x}_r$ are placed on $\Gamma _0$ and, when it is known, on $\Gamma _s$. Top right: types of irregularity considered. Bottom: inverse problems; dashed orange lines and orange shading denote unknowns, and all other quantities are known.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:problem_statement}{{1}{3}{Problem setting. Top left: an irregularity $\Omega _1$ with properties $(\mu _1,\rho _1)$, bounded by the free surface $\Gamma _s$ and the interface $\Gamma _I$, embedded in a half-space $\Omega _2$ with properties $(\mu _2,\rho _2)$ and flat free surface $\Gamma _0$, excited by a plane SH wave with frequency $\eta $ and incidence angle $\alpha $; receivers $\mathbf {x}_r$ are placed on $\Gamma _0$ and, when it is known, on $\Gamma _s$. Top right: types of irregularity considered. Bottom: inverse problems; dashed orange lines and orange shading denote unknowns, and all other quantities are known}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Hybrid BEM--PINN Inversion}{3}{section.2}\protected@file@percent }
\newlabel{sec:methodology}{{2}{3}{Hybrid BEM--PINN Inversion}{section.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Inversion workflows implemented on the same differentiable BEM. (a)~BEM--PINN: the network predicts source densities, and its weights $\theta $ and the geometric and material unknowns $\vartheta $ are updated jointly from a weighted loss combining boundary residuals, data misfit and regularization; no linear system is solved. (b)~BEM + L-BFGS with adjoint gradients: the BEM system is solved for each objective evaluation and differentiated to update $\vartheta $. Here $d$ denotes observed records and $\mathbf  {u}$ the predicted receiver responses. Dashed boxes mark modular components that may change when prototyping a variant; dashed blue arrows indicate gradient or optimization paths.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:methodology_scheme}{{2}{4}{Inversion workflows implemented on the same differentiable BEM. (a)~BEM--PINN: the network predicts source densities, and its weights $\theta $ and the geometric and material unknowns $\vartheta $ are updated jointly from a weighted loss combining boundary residuals, data misfit and regularization; no linear system is solved. (b)~BEM + L-BFGS with adjoint gradients: the BEM system is solved for each objective evaluation and differentiated to update $\vartheta $. Here $d$ denotes observed records and $\mathbf {u}$ the predicted receiver responses. Dashed boxes mark modular components that may change when prototyping a variant; dashed blue arrows indicate gradient or optimization paths}{figure.caption.2}{}}
